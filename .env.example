# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://classmate:local-dev-only@localhost:5432/classmatework
# Optional local connection to the separate ClassMate product database.
# Set C2_DB_URL only when you want to enable product-management integration.
C2_DB_URL=
# Telegram username of the student-facing ClassMate bot, without @.
CLASSMATE_BOT_USERNAME=
REDIS_URL=redis://localhost:6379/0

# Required only by the Telegram admin-bot service; never commit the real token.
TELEGRAM_BOT_TOKEN=
BOT_FSM_TTL_SECONDS=1800
BOT_UPDATE_LEASE_SECONDS=180
BOT_MESSAGE_RATE_LIMIT=30
BOT_CALLBACK_RATE_LIMIT=45
BOT_RATE_LIMIT_WINDOW_SECONDS=60
CLASSMATE_TELEMETRY_HASH_KEY=
